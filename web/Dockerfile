FROM node:20.19-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.34.5 --activate
COPY package.json pnpm-lock.yaml .npmrc ./
RUN pnpm install --frozen-lockfile
COPY . .
ARG NEXT_PUBLIC_SCENARIO_FORGE_MODE
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SCENARIO_FORGE_CORPUS_VERSION
ARG NEXT_PUBLIC_SCENIC_DEFAULT_GENERATION_MODE=baseline
ARG NEXT_PUBLIC_DEMO_ACCOUNT_EMAIL
ARG NEXT_PUBLIC_DEMO_ACCOUNT_PASSWORD
ENV NEXT_PUBLIC_SCENARIO_FORGE_MODE=$NEXT_PUBLIC_SCENARIO_FORGE_MODE \
    NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_SCENARIO_FORGE_CORPUS_VERSION=$NEXT_PUBLIC_SCENARIO_FORGE_CORPUS_VERSION \
    NEXT_PUBLIC_SCENIC_DEFAULT_GENERATION_MODE=$NEXT_PUBLIC_SCENIC_DEFAULT_GENERATION_MODE \
    NEXT_PUBLIC_DEMO_ACCOUNT_EMAIL=$NEXT_PUBLIC_DEMO_ACCOUNT_EMAIL \
    NEXT_PUBLIC_DEMO_ACCOUNT_PASSWORD=$NEXT_PUBLIC_DEMO_ACCOUNT_PASSWORD
RUN test "$NEXT_PUBLIC_SCENARIO_FORGE_MODE" = provider \
    && test -n "$NEXT_PUBLIC_API_BASE_URL" \
    && test -n "$NEXT_PUBLIC_SCENARIO_FORGE_CORPUS_VERSION" \
    && pnpm build

FROM node:20.19-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/pnpm-lock.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
USER node
EXPOSE 3000
CMD ["./node_modules/.bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]
